
-- FRYY HUB V3 | BLUE NEON
-- LocalScript | GUI + Close/Reopen + Auto Steal toggle

local Players = game:GetService("Players")
local player = Players.LocalPlayer
local gui = Instance.new("ScreenGui")
gui.Name = "FRYY_HUB"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local blue = Color3.fromRGB(0, 170, 255)
local dark = Color3.fromRGB(8, 16, 36)

local function makeButton(parent, text, size, pos)
    local b = Instance.new("TextButton")
    b.Size = size
    b.Position = pos
    b.BackgroundColor3 = Color3.fromRGB(19, 48, 83)
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Text = text
    b.TextScaled = true
    b.Font = Enum.Font.GothamBold
    b.Parent = parent
    Instance.new("UICorner", b).CornerRadius =
        UDim.new(0, 12)
    local stroke = Instance.new("UIStroke", b)
    stroke.Color = blue
    stroke.Thickness = 1.5
    return b
end

local panel = Instance.new("Frame")
panel.Size = UDim2.new(0, 320, 0, 270)
panel.Position = UDim2.new(0.5, -160, 0.5, -135)
panel.BackgroundColor3 = dark
panel.Parent = gui
Instance.new("UICorner", panel).CornerRadius =
    UDim.new(0, 18)
local outline = Instance.new("UIStroke", panel)
outline.Color = blue
outline.Thickness = 2

local title = Instance.new("TextLabel")
title.Size = UDim2.new(0.72, 0, 0, 45)
title.Position = UDim2.new(0, 12, 0, 5)
title.BackgroundTransparency = 1
title.Text = "⚡ FRYY HUB V3"
title.TextColor3 = blue
title.TextScaled = true
title.Font = Enum.Font.GothamBlack
title.Parent = panel

local close = makeButton(panel, "X",
    UDim2.new(0, 40, 0, 38),
    UDim2.new(1, -48, 0, 8))

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -20, 0, 35)
status.Position = UDim2.new(0, 10, 0, 55)
status.BackgroundTransparency = 1
status.Text = "● FRYY HUB READY"
status.TextColor3 = Color3.fromRGB(60, 255, 170)
status.TextScaled = true
status.Font = Enum.Font.GothamBold
status.Parent = panel

local enabled = false
local auto = makeButton(panel, "AUTO STEAL: OFF",
    UDim2.new(1, -30, 0, 55),
    UDim2.new(0, 15, 0, 105))

auto.Activated:Connect(function()
    enabled = not enabled
    auto.Text = enabled and
        "AUTO STEAL: ON" or "AUTO STEAL: OFF"
    status.Text = enabled and
        "Toggle ON — ready to configure" or
        "● FRYY HUB READY"
end)

local info = makeButton(panel, "EGG STEAL STATUS",
    UDim2.new(1, -30, 0, 45),
    UDim2.new(0, 15, 0, 175))

info.Activated:Connect(function()
    status.Text = "Use the game's egg interaction"
end)

local reopen = makeButton(gui, "⚡ FRYY",
    UDim2.new(0, 90, 0, 45),
    UDim2.new(0, 15, 0.5, -22))
reopen.Visible = false

close.Activated:Connect(function()
    panel.Visible = false
    reopen.Visible = true
end)

reopen.Activated:Connect(function()
    panel.Visible = true
    reopen.Visible = false
end)



