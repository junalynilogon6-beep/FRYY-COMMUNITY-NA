-- 🔵 FRYY HUB V3 | LocalScript
-- For your own Roblox game

local Players = game:GetService("Players")
local player = Players.LocalPlayer
local UIS = game:GetService("UserInputService")

local gui = Instance.new("ScreenGui")
gui.Name = "FRYY_HUB_V3"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 280, 0, 360)
frame.Position = UDim2.new(0.5, -140, 0.5, -180)
frame.BackgroundColor3 = Color3.fromRGB(5, 15, 40)
frame.BorderSizePixel = 0
frame.Active = true
frame.Draggable = true
frame.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 14)
corner.Parent = frame

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(0, 170, 255)
stroke.Thickness = 2
stroke.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 48)
title.BackgroundColor3 = Color3.fromRGB(0, 65, 140)
title.Text = "❄ FRYY HUB V3 ❄"
title.TextColor3 = Color3.new(1, 1, 1)
title.TextSize = 22
title.Font = Enum.Font.GothamBold
title.Parent = frame

local titleCorner = Instance.new("UICorner")
titleCorner.CornerRadius = UDim.new(0, 12)
titleCorner.Parent = title

local names = {
    "Fly",
    "Instant Steal",
    "Anti-Trap",
    "Anti-Steal",
    "Teleport Egg",
    "Egg Steal"
}

for i, name in ipairs(names) do
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -24, 0, 38)
    button.Position = UDim2.new(0, 12, 0, 58 + (i-1)*47)
    button.BackgroundColor3 = Color3.fromRGB(0, 45, 95)
    button.TextColor3 = Color3.fromRGB(100, 220, 255)
    button.Text = "  " .. name
    button.TextSize = 16
    button.Font = Enum.Font.GothamBold
    button.Parent = frame

    local bc = Instance.new("UICorner")
    bc.CornerRadius = UDim.new(0, 8)
    bc.Parent = button

    local bs = Instance.new("UIStroke")
    bs.Color = Color3.fromRGB(0, 130, 255)
    bs.Thickness = 1
    bs.Parent = button

    button.Activated:Connect(function()
        print("FRYY HUB: " .. name .. " selected")
    end)
end

print("🔵 FRYY HUB V3 loaded!")
